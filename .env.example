# =============================================================================
# Shared environment for the full-stack docker-compose.yml
# Copy to .env and adjust values as needed.
# =============================================================================

# ---------- Git repositories (cloned during image build) ----------
BACKEND_REPO=https://github.com/Mohammad-Alaaei/node-dns-server.git
BACKEND_REF=main
FRONTEND_REPO=https://github.com/Mohammad-Alaaei/dns-server-frontend.git
FRONTEND_REF=main

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root_secret
DB_NAME=dns_server
DB_USER=dns
DB_PASSWORD=secret
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_LOGGING=false

# ---------- Backend admin bootstrap ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ---------- JWT / API ----------
API_JWT_SECRET=change-me-in-production
API_JWT_EXPIRES_IN=15m
API_REFRESH_EXPIRES_IN=7d

# CORS – include https origins when HTTPS is enabled
API_CORS_ORIGINS=http://localhost,http://127.0.0.1,https://localhost,https://127.0.0.1

# Optional persistent RSA PEMs for login password encryption (\n for newlines)
# API_RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# API_RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ---------- DNS operational defaults ----------
CACHE_LEVEL=ALL
CACHE_EXPIRE_TIME=60
FLUSH_INTERVAL_MS=60000
DNS_TTL=60
DNS_TIMEOUT=8000
PTR_HOSTNAME=localhost.com
DEBUG_PREFIX=_.

# Space- or comma-separated IPs that mark answers as FILTERED
# (required for FILTERED_ONLY cache level to store anything)
FILTER_IPS=10.10.34.35 10.10.34.34 10.10.34.36 2001:4188:2:600:10:10:34:35

# Space- or comma-separated IPs to skip from the log queue only
# (cache behaviour still follows CACHE_LEVEL)
IGNORE_IPS=10.10.34.35 10.10.34.34 10.10.34.36 2001:4188:2:600:10:10:34:35 50.7.5.83 50.7.87.5 50.7.87.4 0.0.0.0

# ---------- Logger ----------
LOG_FLUSH_INTERVAL=5000
LOG_MAX_BUFFER_SIZE=100
LOG_MAX_SIZE_KB=10240

# ---------- Optional UI defaults (baseline for new user settings) ----------
UI_LANGUAGE=en
UI_THEME=system
UI_DARK_MODE=false

# DNS IPv6 (container should use ::)
SERVER_IPV6=::

# ---------- Frontend TLS (nginx) ----------
# HTTPS_ENABLED=true|false (default true). When false, SSL_MODE is forced off.
HTTPS_ENABLED=true
# SSL_MODE=selfsigned|custom|off (default selfsigned)
SSL_MODE=selfsigned
# Comma-separated DNS names / IPs for self-signed SAN list
SSL_CERT_HOSTS=localhost,127.0.0.1
# Host directory mounted at /etc/nginx/certs (custom certs or persistent self-signed)
SSL_CERTS_DIR=./certs
